Name: gnustep-base
Description: The GNUstep Base Library is a library of general-purpose, non-graphical Objective C objects.
Version: 1.31.1
URL: https://github.com/gnustep/libs-base/
Libs: -shared-libgcc -pthread -fexceptions -rdynamic -L/opt/GNUstep/Local/Library/Libraries -L/opt/GNUstep/System/Library/Libraries -lobjc -lm
Cflags: -MMD -MP -DGNU_RUNTIME=1 -DGNUSTEP_BASE_LIBRARY=1 -fno-strict-aliasing -fexceptions -fobjc-exceptions -D_NATIVE_OBJC_EXCEPTIONS -pthread -fPIC -Wall -DGSWARN -DGSDIAGNOSE -Wno-import -g -O2 -I. -I/opt/GNUstep/Local/Library/Headers -I/opt/GNUstep/System/Library/Headers
