Name: gnustep-gui
Description: The GNUstep gui library is a library of graphical user interface classes written completely in the Objective-C language; the classes are based upon Apple's Cocoa framework (which came from the OpenStep specification).
Version: 0.32.0
URL: https://github.com/gnustep/libs-gui/
Libs: -shared-libgcc -pthread -fexceptions -rdynamic -L/opt/GNUstep/Local/Library/Libraries -L/opt/GNUstep/System/Library/Libraries -lgnustep-base -lobjc -lm
Cflags:  -MMD -MP -DGNUSTEP -DGNUSTEP_BASE_LIBRARY=1 -DGNU_RUNTIME=1 -DGNUSTEP_BASE_LIBRARY=1 -fno-strict-aliasing -fexceptions -fobjc-exceptions -D_NATIVE_OBJC_EXCEPTIONS -pthread -fPIC -Wall -DGSWARN -DGSDIAGNOSE -Wno-import -g -O2 -fconstant-string-class=NSConstantString -I. -I/opt/GNUstep/Local/Library/Headers -I/opt/GNUstep/System/Library/Headers
