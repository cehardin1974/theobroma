+then
+  present "$GSTESTSUM" "Failed set$" "Failed sets$" "Failed test$" "Failed tests$" "Failed build$" "Failed builds$" "Failed file$" "Failed files$"
+  if [ $? = 1 ]
+  then
+    exit 0
+  else
+    exit 1
+  fi
+else
+  exit 0
+fi
